###############################################
# GDHS Dev Dynamos - Example Environment File #
###############################################
# Copy this file to `.env` and fill in values. 
# NEVER commit real secrets. The real `.env` is git-ignored.

# --- Backend (optional but recommended) ---
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
BIOPORTAL_API_KEY=your-bioportal-key-here

# --- Frontend (Supabase auth - optional) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# --- Scheduling System ---
# Database Configuration
DATABASE_URL=sqlite:///./medical_scheduling.db
# For PostgreSQL: postgresql://user:password@localhost:5432/medical_scheduling

# Daily.co Video API Configuration
DAILY_API_KEY=your_daily_api_key_here
WEBHOOK_BASE_URL=http://localhost:8000

# Authentication (if using external auth service)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Timezone Settings
DEFAULT_TIMEZONE=Asia/Kolkata

# Booking Constraints
MIN_BOOKING_LEAD_TIME_MINUTES=30
MAX_FUTURE_BOOKING_WEEKS=8
CANCELLATION_DEADLINE_MINUTES=30

# Notes:
# - Leave keys blank to run with deterministic fallbacks (no external LLM/ontology)
# - Rotate any key that was ever exposed publicly.